-- 3. ESP System
--------------------------------------------------------------------------------
local ESPObjects = {}

local function RemoveESP(player)
	if ESPObjects[player] then
		for _, v in pairs(ESPObjects[player]) do
			if v then v:Destroy() end
		end
		ESPObjects[player] = nil
	end
end

local function ApplyESP(player)
	if player == LocalPlayer then return end
	RemoveESP(player)

	local function SetupCharacter(char)
		if not char then return end
		local root = char:WaitForChild("HumanoidRootPart", 5)
		local head = char:WaitForChild("Head", 5)
		if not root or not head then return end

		ESPObjects[player] = {}

		local highlight = Instance.new("Highlight")
		highlight.Name = "Zakaito_Highlight"
		highlight.Adornee = char
		highlight.FillColor = Color3.fromRGB(235, 52, 122)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.4
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Enabled = Features.ESP_Highlight
		highlight.Parent = char
		table.insert(ESPObjects[player], highlight)

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "Zakaito_NameTag"
		billboard.Adornee = head
		billboard.Size = UDim2.new(0, 120, 0, 30)
		billboard.StudsOffset = Vector3.new(0, 2.5, 0)
		billboard.AlwaysOnTop = true
		billboard.Enabled = Features.ESP_Names

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(1, 0, 1, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = player.Name
		nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameLabel.TextStrokeTransparency = 0.3
		nameLabel.Font = Enum.Font.GothamMedium
		nameLabel.TextSize = 12
		nameLabel.Parent = billboard
		billboard.Parent = head

		table.insert(ESPObjects[player], billboard)
	end

	player.CharacterAdded:Connect(SetupCharacter)
	if player.Character then SetupCharacter(player.Character) end
end

for _, p in pairs(Players:GetPlayers()) do ApplyESP(p) end
Players.PlayerAdded:Connect(ApplyESP)
Players.PlayerRemoving:Connect(RemoveESP)

local function UpdateESPState()
	for player, objs in pairs(ESPObjects) do
		for _, obj in pairs(objs) do
			if obj:IsA("Highlight") then
				obj.Enabled = Features.ESP_Highlight
			elseif obj:IsA("BillboardGui") then
				obj.Enabled = Features.ESP_Names
			end
		end
	end
end

